# SQLite for local development. connection_limit=1 serialises writes, which
# avoids SQLite lock-upgrade deadlocks when movements are recorded concurrently.
# For production, switch the provider in
# prisma/schema.prisma to "postgresql" and use a postgres:// URL here.
DATABASE_URL="file:./dev.db?connection_limit=1"

# Credentials for the first admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@trifold.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Set to "false" to seed only the admin user, without demo locations/products.
SEED_DEMO_DATA="true"
