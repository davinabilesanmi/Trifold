# --- Database (PostgreSQL) -------------------------------------------------
# Local development: a Postgres database on this machine.
# Production (Supabase): Project Settings -> Database -> Connection string.
#   DATABASE_URL = the "Transaction pooler" string (port 6543), with
#                  ?pgbouncer=true&connection_limit=5 added to the end
#   DIRECT_URL   = the "Session pooler" string (port 5432). Use the pooler, not the
#                  "Direct connection": that one is IPv6-only, which many hosts lack.
DATABASE_URL="postgresql://trifold:trifold@localhost:5432/trifold_dev"
DIRECT_URL="postgresql://trifold:trifold@localhost:5432/trifold_dev"

# Used by `npm test` only. It is wiped on every test run, so never point it at real data.
TEST_DATABASE_URL="postgresql://trifold:trifold@localhost:5432/trifold_test"

# --- First owner account (created by `npm run db:seed`) --------------------
SEED_ADMIN_EMAIL="admin@trifold.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# "true" adds sample cement data and demo staff. Use "false" for the real system.
SEED_DEMO_DATA="true"
